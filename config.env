# config.env — edite e rode ./mc restart
# Os valores do servidor (nome, porta, jogadores...) só são aplicados na CRIAÇÃO do server.properties.
# Depois disso, edite server/server.properties direto (ou apague server/.configured para reaplicar).

# --- qual servidor ---
SERVER_TYPE="bds"            # "bds" = servidor oficial da Mojang (padrão) | "pocketmine" = fork da comunidade

# --- BDS (servidor oficial) ---
BDS_VERSION="latest"         # "latest" ou uma versão, ex: 1.26.50.25
BDS_URL=""                   # opcional: cole o link do botão Ubuntu/Linux de minecraft.net/en-us/download/server/bedrock
BDS_ZIP=""                   # opcional: caminho de um .zip já enviado ao sandbox (use se a rede bloquear a Mojang)
BDS_TRANSPORT_RAKNET="1"     # escreve transport=raknet no server.properties (pedido pela página do túnel do playit)

# --- PocketMine (só se SERVER_TYPE="pocketmine") ---
# O PocketMine oficial (pmmp) encerrou o suporte em 2026-07-09 e parou na 26.30; o padrão abaixo é um fork da comunidade.
PM_REPO="BetterLite/PocketMine-MP"
PM_VERSION="latest"
PHP_VERSION="8.4"            # 8.2 | 8.3 | 8.4 | 8.5

# --- servidor (valores iniciais do server.properties) ---
SERVER_NAME="Bedrock Daytona"
SERVER_PORT="19132"          # UDP
MAX_PLAYERS="8"
VIEW_DISTANCE="8"
GAMEMODE="survival"
DIFFICULTY="normal"
ONLINE_MODE="true"           # "false" deixa entrar sem conta Xbox (inseguro na internet)
LEVEL_NAME="Bedrock level"

# --- execução ---
AUTO_RESTART="1"             # reinicia se cair (para após 3 quedas em <30s)
BACKUP_KEEP="3"              # o disco do sandbox é pequeno; mantenha poucos

# --- playit (a única forma de alcançar UDP de fora do Daytona) ---
USE_PLAYIT="1"
PLAYIT_VERSION="v1.0.10"     # "latest" arrisca mudança de CLI
